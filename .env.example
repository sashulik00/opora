# Образец настроек. Скопируйте этот файл в .env и поменяйте значения:
#   Copy-Item .env.example .env
# Файл .env в git не попадает (он в .gitignore) — в нём пароли.

# Порт сайта: http://localhost:3000
PORT=3000

# Пароль базы данных PostgreSQL (его же использует docker-compose.yml).
# Если поменяли — поменяйте и в двух адресах ниже.
# Важно: пароль задаётся только при ПЕРВОМ запуске базы. Если папка pgdata уже есть,
# новый пароль не применится — удалите pgdata (данные пропадут) или верните старый пароль.
POSTGRES_PASSWORD=change_me

# Адрес основной базы и отдельной базы для тестов (npm test)
DATABASE_URL=postgres://opora:change_me@localhost:5432/opora
TEST_DATABASE_URL=postgres://opora:change_me@localhost:5432/opora_test

# Секрет для подписи токенов входа: длинная случайная строка (не короче 32 символов).
# Получить случайную строку: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# true — cookie входа только по https (на настоящем хостинге). На своём компьютере — false
COOKIE_SECURE=false
